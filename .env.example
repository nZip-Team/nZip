# Public origin the site is served from
HOST=http://localhost:3000
PORT=3000

# Gallery API and image host; both required, absolute URLs
API_URL=
IMAGE_URL=

# Parallel image fetches per gallery
CONCURRENT_IMAGE_DOWNLOADS=16
# WebSocket upgrades per minute per client; 0 disables
RATE_LIMIT=10
# Searches per minute per client (after a burst of 1.5x) and per hour; 0 disables
SEARCH_RATE_LIMIT=20
SEARCH_HOURLY_LIMIT=300

# Behind a reverse proxy or CDN set both, or every client shares the proxy's rate-limit bucket.
# List only the proxies: anything matched may name the client, so 0.0.0.0/0 lets anyone spoof it.
#   cloudflared or a proxy on the same host: 127.0.0.1,::1
#   proxy containers on the Docker network:  172.16.0.0/12
# Behind Cloudflare the client address comes from CF-Connecting-IP.
TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXIES=

# Log raw client IPs instead of salted hash tags
LOG_CLIENT_IP=false
# Keeps the tags stable across restarts and instances
LOG_CLIENT_SALT=
# text, or json for one JSON object per line
LOG_FORMAT=text

# Analytics script tag, inserted into <head> as is; empty disables it. For nZip Analytics (Umami compatible):
#   ANALYTICS=<script defer src="https://api.nhentai.zip/script.js" data-website-id="YOUR-ID" data-do-not-track="true"></script>
# data-do-not-track makes the tracker skip browsers with Do Not Track on. The site's own events go through window.umami.track.
ANALYTICS=
# Content-Security-Policy of the pages. Empty: derived from API_URL, IMAGE_URL and the URLs in ANALYTICS.
# Set a whole policy to replace it, or "off" to send none.
CONTENT_SECURITY_POLICY=

# development or production
NODE_ENV=development

# S3 storage for finished archives (empty S3_BUCKET = local disk only)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
# Bucket in the host name (bucket.endpoint) instead of the path
S3_VIRTUAL_HOSTED_STYLE=false
# Archives up to this many MB upload as one request instead of 5 MB parts
S3_PART_SIZE_MB=64
# Uploads running at once per instance; the rest wait
S3_UPLOAD_CONCURRENCY=3
# true = no uploads and no evictions; archives stay on local disk until their session ends
S3_UPLOADS_PAUSED=false

# Days without a download before an archive is evicted (0 = never)
ARCHIVE_RETENTION_DAYS=7
# Size cap; least recently downloaded archives go first (0 = no cap)
ARCHIVE_MAX_GB=0

# How long a stopping instance lets running downloads finish. The whole shutdown takes up to
# this + 25 s, so keep stop_grace_period (90 s in the compose files) above that.
DRAIN_TIMEOUT_SECONDS=60

# Docker: the container starts as root, hands the Cache volume to the bun user and runs as it.
# true keeps root (only for hosts where the volume's owner cannot change)
NZIP_RUN_AS_ROOT=false

# compose.ha.yml: Cloudflare Tunnel token (public hostname -> http://nzip-lb:80)
TUNNEL_TOKEN=
# compose.ha.yml: LAN port of the load balancer (its :81 listener; /metrics/nzip-a and /metrics/nzip-b live there)
NZIP_PORT=3000
