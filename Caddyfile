# Load balancer for compose.ha.yml
{
	# Only reachable inside the container: `docker exec nzip-lb caddy reload --config /etc/caddy/Caddyfile`
	admin localhost:2019
	auto_https off
	servers {
		# Keep the X-Forwarded-For from cloudflared
		trusted_proxies static private_ranges
	}
}

(upstreams) {
	lb_try_duration 30s
	lb_try_interval 250ms

	# 503 while draining
	health_uri /healthz
	health_interval 2s
	health_timeout 2s
	health_status 200
	fail_duration 10s

	flush_interval -1
}

:80 {
	# One client's searches always reach the same instance, so its search limits are not doubled
	@search path /search
	handle @search {
		reverse_proxy nzip-a:3000 nzip-b:3000 {
			lb_policy header CF-Connecting-IP
			import upstreams
		}
	}

	handle {
		reverse_proxy nzip-a:3000 nzip-b:3000 {
			lb_policy uri_hash
			import upstreams
		}
	}
}
